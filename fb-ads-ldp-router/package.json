{
  "name": "ldp-router",
  "version": "1.0.0",
  "private": true,
  "description": "FB Ads dynamic landing-page router with multi-armed bandit A/B testing on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ldp_router --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ldp_router --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.86.0"
  }
}
