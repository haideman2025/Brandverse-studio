{
  "name": "brandverse-smart-link-router",
  "version": "0.1.0",
  "private": true,
  "description": "1 link quảng cáo Facebook -> tự xoay 5-10 landing page (Ladipage), đo CR và tự tối ưu bằng multi-armed bandit.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute slr-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute slr-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}
